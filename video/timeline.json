 "caps": [
  {
   "start": 0.3,
   "end": 3.3,
   "text": "蓋大樓最卡的，就是人力",
   "line": "P1"
  },
  {
   "start": 3.55,
   "end": 5.678,
   "text": "一天能施工的時間有限",
   "line": "P2"
  },
  {
   "start": 5.678,
   "end": 8.194,
   "text": "工地有一大半時間是停著的",
   "line": "P2"
  },
  {
   "start": 8.444,
   "end": 12.044,
   "text": "只要一關卡住，後面全部跟著延",
   "line": "P3"
  },
  {
   "start": 12.45,
   "end": 15.983,
   "text": "所以我一直在想：如果工地本身",
   "line": "P4"
  },
  {
   "start": 16.083,
   "end": 18.539,
   "text": "就是一台二十四小時不停工",
   "line": "P5"
  },
  {
   "start": 18.539,
   "end": 20.239,
   "text": "還會長高的機器呢？",
   "line": "P5"
  },
  {
   "start": 20.8,
   "end": 23.849,
   "text": "開工前，AI 先讀懂建築設計圖",
   "line": "A1"
  },
  {
   "start": 23.849,
   "end": 27.089,
   "text": "把整棟樓拆成一條條自動化建造腳本",
   "line": "A1"
  },
  {
   "start": 27.55,
   "end": 29.834,
   "text": "接著在系統裡完整蓋一次",
   "line": "A2"
  },
  {
   "start": 29.834,
   "end": 33.45,
   "text": "碰撞和工序衝突先抓出來修掉，驗證通過",
   "line": "A2"
  },
  {
   "start": 33.45,
   "end": 34.972,
   "text": "才動真正的工地",
   "line": "A2"
  },
  {
   "start": 35.917,
   "end": 40.103,
   "text": "主要的柱、梁和樓板，先在工廠預鑄成模組",
   "line": "F1"
  },
  {
   "start": 40.103,
   "end": 42.406,
   "text": "工地只負責吊裝和接合",
   "line": "F1"
  },
  {
   "start": 42.9,
   "end": 47.611,
   "text": "從第一天開始，無人機建模、連續壁、基樁",
   "line": "B1"
  },
  {
   "start": 47.817,
   "end": 49.639,
   "text": "自動開挖",
   "line": "B2"
  },
  {
   "start": 50.483,
   "end": 54.772,
   "text": "第二十七天，天架登場，就站在連續壁上",
   "line": "B3"
  },
  {
   "start": 55.167,
   "end": 58.567,
   "text": "立柱和手臂都是模組，依建築大小增減",
   "line": "S1"
  },
  {
   "start": 58.567,
   "end": 61.967,
   "text": "不管規模多大，都能用同一套邏輯擴充",
   "line": "S1"
  },
  {
   "start": 62.517,
   "end": 67.095,
   "text": "重型手臂吊裝預鑄構件，主體結構兩天一層",
   "line": "B4"
  },
  {
   "start": 67.45,
   "end": 71.235,
   "text": "白天排吊裝和灌漿，夜間換低噪音工序",
   "line": "B5"
  },
  {
   "start": 71.235,
   "end": 72.917,
   "text": "二十四小時接力",
   "line": "B5"
  },
  {
   "start": 73.25,
   "end": 77.059,
   "text": "天架每長高一層，就錨回剛完成的樓板",
   "line": "B6"
  },
  {
   "start": 77.059,
   "end": 78.117,
   "text": "愈蓋愈穩",
   "line": "B6"
  },
  {
   "start": 78.45,
   "end": 81.926,
   "text": "輕型手臂跟在後面，裝上阻尼器",
   "line": "B7"
  },
  {
   "start": 81.926,
   "end": 83.317,
   "text": "再掛上外牆",
   "line": "B7"
  },
  {
   "start": 83.65,
   "end": 85.735,
   "text": "工地不用整個封起來",
   "line": "B8"
  },
  {
   "start": 85.735,
   "end": 88.028,
   "text": "路人抬頭就看得到進度",
   "line": "B8"
  },
  {
   "start": 88.483,
   "end": 92.883,
   "text": "颱風要來，手臂先收回，防護網捲起來",
   "line": "B9"
  },
  {
   "start": 93.25,
   "end": 97.488,
   "text": "封頂後先拆頂棚，天架一路下降，節段回收",
   "line": "B10"
  },
  {
   "start": 97.488,
   "end": 99.183,
   "text": "帶去下一個工地",
   "line": "B10"
  },
  {
   "start": 100.65,
   "end": 101.71,
   "text": "室內裝潢",
   "line": "B11"
  },
  {
   "start": 101.71,
   "end": 106.161,
   "text": "再交給人形機器人和裝潢專屬機器人分工完成",
   "line": "B11"
  },
  {
   "start": 106.617,
   "end": 109.573,
   "text": "十二層樓，九十天完工",
   "line": "E0"
  },
  {
   "start": 109.822,
   "end": 113.941,
   "text": "整套系統把現場人力降到最低，施工更安全",
   "line": "E1"
  },
  {
   "start": 113.941,
   "end": 116.0,
   "text": "時程更準，精度更高",
   "line": "E1"
  },
  {
   "start": 116.45,
   "end": 120.912,
   "text": "工期縮短，噪音、粉塵和交通對鄰居的影響",
   "line": "R1"
  },
  {
   "start": 120.912,
   "end": 122.25,
   "text": "也跟著縮短",
   "line": "R1"
  },
  {
   "start": 122.867,
   "end": 126.4,
   "text": "這還是概念模擬，數字都是示意",
   "line": "E2"
  },
  {
   "start": 126.7,
   "end": 128.987,
   "text": "但我想問你：這樣的工地",
   "line": "E3"
  },
  {
   "start": 128.987,
   "end": 131.656,
   "text": "你覺得多久會出現在我們身邊？",
   "line": "E3"
  }
 ],
 "siteSwitch": 0
